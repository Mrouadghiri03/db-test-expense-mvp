<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp"
              android:background="@color/background_light"
              android:theme="@style/Theme.GitReposMVVM">

    <!-- Header avec icône -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_add_expense"
                android:backgroundTint="@color/primary_light"
                android:padding="12dp"
                android:background="@drawable/circle_background"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une dépense"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- CardView pour le formulaire -->
    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="24dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <!-- Champ Titre -->
            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@drawable/ic_title"
                    app:startIconTint="@color/primary_color"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_color"
                    app:hintTextColor="@color/primary_color"
                    app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Titre de la dépense"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:paddingVertical="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ Montant -->
            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:startIconDrawable="@drawable/ic_amount"
                    app:startIconTint="@color/primary_color"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_color"
                    app:hintTextColor="@color/primary_color"
                    app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Montant"
                        android:inputType="numberDecimal"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:paddingVertical="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bouton Ajouter -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Ajouter la dépense"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:cornerRadius="28dp"
                    app:backgroundTint="@color/primary_color"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bouton pour aller à la liste -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToList"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Voir la liste des dépenses"
            android:textSize="16sp"
            app:icon="@drawable/ic_list"
            app:iconGravity="textStart"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/secondary_color"
            android:textColor="@color/white"
            style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>